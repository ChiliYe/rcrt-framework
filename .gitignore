# ==============================================================================
# 1. Tauri & Rust 后端忽略规则
# ==============================================================================
# Tauri 构建产物
src-tauri/target/
src-tauri/gen/

# Rust 编译产物
*.rs.bk
Cargo.lock

# ==============================================================================
# 2. React & Node.js 前端忽略规则
# ==============================================================================
# 依赖包目录（体积巨大，严禁提交）
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
.vite/

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 测试覆盖率
coverage/

# ==============================================================================
# 3. 操作系统生成的文件
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ==============================================================================
# 4. IDE 与编辑器配置
# ==============================================================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA / WebStorm
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# ==============================================================================
# 5. 环境与敏感信息 (重要！)
# ==============================================================================
# 环境变量文件（可能包含 API Key、数据库密码等）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 临时文件
*.tmp
*.temp
.cache/
